# ===== App =====
APP_NAME=LearnSphere API
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Logging =====
LOG_LEVEL=INFO
LOG_JSON=false

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Database (MySQL) =====
# Recommended for production: set DATABASE_URL to a single connection string.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=lms_user
DB_PASSWORD=lms_password
DB_NAME=lms_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_SSL=false

# ===== Storage =====
STORAGE_BACKEND=local
STORAGE_ROOT=storage
VIDEOS_SUBDIR=videos
THUMBNAILS_SUBDIR=thumbnails
VIDEO_STREAM_CHUNK_SIZE=1048576
THUMBNAILS_URL_PREFIX=/static/thumbnails

# ===== Cloudinary (only when STORAGE_BACKEND=cloudinary) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=videos

# ===== Content sync =====
AUTO_SEED_ON_STARTUP=true
AUTO_SEED_PRUNE_MISSING=true

# ===== Auth (email-based, no OAuth, no passwords) =====
# The single email address that gets the "instructor" role.
# Everyone else who logs in gets the "learner" role.
INSTRUCTOR_EMAIL=instructor@example.com
# Secret used to sign session tokens. Use a long random string in production.
SESSION_SECRET=change-me-in-production-please-use-a-long-random-string
